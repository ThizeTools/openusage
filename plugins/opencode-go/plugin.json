{
  "schemaVersion": 1,
  "id": "opencode-go",
  "name": "OpenCode",
  "version": "0.0.1",
  "entry": "plugin.js",
  "icon": "icon.svg",
  "brandColor": "#000000",
  "links": [
    {
      "label": "Console",
      "url": "https://opencode.ai/auth"
    },
    {
      "label": "Docs",
      "url": "https://opencode.ai/docs/go/"
    }
  ],
  "auth": {
    "kind": "device",
    "deviceUrl": "https://opencode.ai/console/auth/device/code",
    "tokenUrl": "https://opencode.ai/console/auth/device/token",
    "clientId": "opencode-cli",
    "encoding": "form",
    "deviceParams": {
      "supports_org_scope": "true"
    }
  },
  "lines": [
    {
      "type": "progress",
      "label": "Session",
      "scope": "overview",
      "primaryOrder": 1
    },
    {
      "type": "progress",
      "label": "Weekly",
      "scope": "overview",
      "primaryOrder": 2
    },
    {
      "type": "progress",
      "label": "Monthly",
      "scope": "detail"
    }
  ]
}
